## ---- LaTeX table bodies (Panels A, B and C) --------------------------------------------
## Writes only the rows (the "meat"): one row per scenario with 8 numeric columns (9 in
## Panel B), then a \midrule and a row with average seconds per test. Local-in-X scenarios are
## labelled as indented continuations of the row above. The last row has no closing \\\\: the
## table adds it after the \\input (a \\\\ at the end of an input file breaks a following \\addlinespace).
fmt <- function(x, d) if (length(x) == 0L || is.na(x)) "" else formatC(x, format = "f", digits = d)
## Row labels are written as macros (\\rowSzeroNull etc.), defined in LABELFILE inside TEXDIR. The label
## file is never overwritten: it is created on the first run, and later runs only append macros that
## are missing, so hand edits of the label text survive a new simulation run.
LABELFILE <- "sim_rowlabels.tex"
macro_name <- function(sc) {                    # S1_persistent_X -> \\rowSonePersistentX
w <- c("zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine")
parts <- strsplit(sc, "_")[[1]]
parts <- vapply(parts, function(p) paste0(toupper(substring(p, 1, 1)), substring(p, 2)), "")
ch <- strsplit(paste(parts, collapse = ""), "")[[1]]
dig <- grepl("[0-9]", ch)
ch[dig] <- vapply(ch[dig], function(d) paste0(toupper(substring(w[as.integer(d) + 1], 1, 1)),
substring(w[as.integer(d) + 1], 2)), "")
nm <- paste(ch, collapse = "")
paste0("\\row", nm)
}
update_labels <- function(defs) {               # defs: named character vector, macro name -> label text
f <- file.path(TEXDIR, LABELFILE)
old <- if (file.exists(f)) readLines(f) else
c("% Row labels for the simulation tables. Created by sim_KR.R; edit freely, new runs never",
"% overwrite this file (they only append macros that are missing).")
new <- defs[!vapply(names(defs), function(m) any(startsWith(old, paste0("\\newcommand{", m, "}"))), NA)]
if (length(new))
writeLines(c(old, paste0("\\newcommand{", names(new), "}{", new, "}")), f)
}
write_meat <- function(sub, rows, cols, file) {
cell <- function(sc, cc, what, d) {
if (is.null(cc)) return("")
v <- sub[scenario == sc & test == cc[1] & search == cc[2], get(what)]
fmt(v, d)
}
keep <- names(rows)[names(rows) %in% sub$scenario]
mac  <- setNames(vapply(keep, macro_name, ""), keep)
update_labels(c(setNames(rows[keep], mac), c("\\rowSeconds" = "Seconds per test")))
body <- vapply(keep, function(sc)
paste0(mac[[sc]], " & ",
paste(vapply(cols, function(cc) cell(sc, cc, "rej", 2), ""), collapse = " & "), " \\\\"), "")
secs <- vapply(cols, function(cc) {
if (is.null(cc)) return("")
fmt(sub[test == cc[1] & search == cc[2], mean(t, na.rm = TRUE)], 1)
}, "")
writeLines(c(body, "\\midrule", paste0("\\rowSeconds & ", paste(secs, collapse = " & "))),
file.path(TEXDIR, file))
}
locX <- "$\\quad$\\ldots local in $X$"
rows_A <- c(
S0_null         = "S0: Null",
S0_boundary     = "S0: Boundary, zero first stage",
S1_persistent   = "S1: Persistent",          S1_persistent_X = locX,
S2_nopersist    = "S2: No persistence",      S2_nopersist_X  = locX,
S3_offsetting   = "S3: Offsetting",          S3_offsetting_X = locX,
S4_directY      = "S4: Direct on $Y$",       S4_directY_X    = locX,
S5_harmlessD2   = "S5: Harmless $D_2$",      S5_harmlessD2_X = locX,
S6_jointwins    = "S6: Large $\\delta_2$",   S6_jointwins_X  = locX)
## 8 columns: FSD, then KR and MW with W = Y, D2, (D2,Y), all with local search (the package
## default; global MW cannot reject), and a global KR-(D2,Y) reference for the cost/gain of search
cols_A <- list(c("FSD", "local"),
c("KR_Y", "local"),   c("KR_D2", "local"),  c("KR_D2Y", "local"),
c("MW_Y", "local"),   c("MW_D2", "local"),  c("MW_D2Y", "local"),
c("KR_D2Y", "global"))
rows_B <- c(
MV0_tracks       = "MV0: $D_2$ tracks $D_1$ (valid)",
MV0_boundary     = "MV0: Boundary, zero first stage",
MV1_levelshift   = "MV1: Level shift (valid)",
MV2_amplify      = "MV2: Amplification (valid)",
MV3_violation    = "MV3: Direct on $D_2$",
MV3_violation_X  = locX,
MV3_violation_D2 = "$\\quad$\\ldots only at $D_1=2$")
## 9 columns (Panel B is its own table): both FSD versions, then KR and MW with W = Y, D2, (D2,Y),
## all local, and the global KR-(D2,Y) reference, mirroring Panel A
cols_B <- list(c("FSD_mean", "local"), c("FSD_thr", "local"),
c("KR_Y", "local"),     c("KR_D2", "local"),  c("KR_D2Y", "local"),
c("MW_Y", "local"),     c("MW_D2", "local"),  c("MW_D2Y", "local"),
c("KR_D2Y", "global"))
rows_C <- c(
U0_null       = "U0: Null",
U0_boundary   = "U0: Boundary, zero first stage",
U1_dropout    = "U1: Dropout effect",          U1_dropout_X  = locX,
U2_directD2   = "U2: Direct on $D_2$",         U2_directD2_X = locX,
U3_defiers    = "U3: Completion defiers",
U4_ATdropoutY = "U4: Direct on $Y$, enrolled dropouts")
## 8 columns: KR first-treatment (outer, KRDY), second-treatment (inner, classic KR for D2 -> Y)
## and joint (KRDY2) conditions with local search, then the global joint and global second-treatment
## KR tests (the cost/gain of search); then the local MW versions (MWDY, MW, MWDY2)
cols_C <- list(c("KRDY", "local"),     c("KR_inner", "local"),  c("KRDY2", "local"),
c("KRDY2", "global"),   c("KR_inner", "global"),
c("MW_D2Y", "local"),   c("MW_inner", "local"),  c("MW_joint", "local"))
write_meat(rr[grepl("^S", scenario)],  rows_A, cols_A, "sim_panelA.tex")
write_meat(rr[grepl("^MV", scenario)], rows_B, cols_B, "sim_panelB.tex")
write_meat(rr[grepl("^U", scenario)],  rows_C, cols_C, "sim_panelC.tex")
cat("LaTeX table bodies written to",
file.path(TEXDIR, c("sim_panelA.tex", "sim_panelB.tex", "sim_panelC.tex")), "\n")
cat("\nOracle complier persistence and first stage, Part A (n = 2e5):\n")
set.seed(1)
print(rbindlist(lapply(scen, function(a)
as.list(do.call(dgp, c(list(n = 2e5, potential = TRUE), a)))), idcol = "scenario"), digits = 3)
if (PILOT) {
secs <- res[, .(s = secs[1]), by = .(scenario, rep)][, mean(s)]
ns   <- length(scen) + length(scen_mv) + length(scen_uc2); cores <- max(1, detectCores() - 2)
cat(sprintf("\nPilot: %.1f s per replication (11 calls in Part A, 12 in Part B, 9 in Part C). Full run (%d scenarios x 100 reps, %d cores): ~%.0f min\n",
secs, ns, cores, secs * ns * 100 / cores / 60))
}
## Simulation: when do the D2-exploiting conditions beat classic Kwon-Roth,
## and how does local search (over X) compare with a global test?
##
## Part A (binary D1, D2). Tests, each run with local search on and off:
##   FSD    : seqtest condition "FSD" (montest "simple", linearD = TRUE, treatment D1 - D2)
##   KR_Y   : montest "KR", outcome = binned Y (classic KR; not a seqtest condition)
##   KR_D2  : seqtest condition "KRD" (montest "KR", outcome = D2)
##   KR_D2Y : seqtest condition "KRDY" (montest "KR", joint outcome (D2, Ybin))
##   MW_D2  : seqtest condition "MWD"  (Mourifie-Wan with D2 on the right-hand side)
##   MW_D2Y : seqtest condition "MWDY" (Mourifie-Wan with D2 and Y on the right-hand side)
## Part B (D1, D2 in {0,1,2}):
##   FSD_mean : montest "simple", linearD = TRUE, treatment D1 - D2 (seqtest FSD requires binary D)
##   FSD_thr  : montest "simple", linearD = TRUE, treatment 1{D1>d} - 1{D2>d}, d = 0,1 (Bonferroni)
##   KR_D2    : seqtest condition "KRD" -- REQUIRES the interior-value fix in montest
## Part C (use case 2: Z instruments D2; D1 = enrollment, D2 = completion, binary, not nested):
##   KRDY2    : seqtest condition "KRDY2" (joint use case 2 test: KRDY plus KR for D2 -> Y)
##   KRDY     : seqtest condition "KRDY" (outer conditions only, as in use case 1)
##   KR_inner : montest "KR", treatment D2, outcome Ybin (classic KR for D2; inner conditions)
##   MW_D2Y   : seqtest condition "MWDY" (outer conditions, conditional form)
##   MW_inner : montest "MW", treatment D2, outcome Y (inner conditions, conditional form)
##   MW_joint : seqtest condition "MWDY2" (joint use case 2 test, MW form)
##
## Assumes montest has an option (LOCAL_ARG below) that, when FALSE, turns off the
## local search over X and the sample splitting. Global calls also set pool = "none", so
## that every margin cell is tested separately instead of being pooled into one moment.
## Run with PILOT = TRUE first.
library(data.table)
library(montest)
library(parallel)
## ---- Settings -------------------------------------------------------------
PILOT     <- FALSE
PROGRESS  <- FALSE                    # show a progress bar (parallel runs then dispatch in chunks)
N         <- 3000
REPS      <- if (PILOT) 2 else 300
CORES     <- if (PILOT) 1 else max(1, detectCores()-2)   # forks on Unix, PSOCK on Windows
NYBIN     <- 2                      # binary Y (median split): KR_Y 4 cells, KR_D2Y 18 cells
ALPHA     <- 0.05
PCOL      <- "p.holm"                 # entry of out$minp used as the test's p-value
LOCAL_ARG <- "local"                  # name of the new montest option
XCUT      <- 0.43                     # local violations: Xvar1 > XCUT (about 1/3 of sample)
MULT      <- 2                        # violation strength inside the local subgroup
TEXDIR    <- "/Users/martiea/Library/CloudStorage/Dropbox/Apps/Overleaf/Testing Monotonicity and Sequential Treatments/results/"                      # where the LaTeX table bodies are written
NTHREADS <- if (CORES == 1 && !PILOT) 0 else 1   # pilot: one GRF thread, to scale timings
GRF      <- list(num.trees = 250, num.threads = NTHREADS)
MT_ARGS <- list(minsize = 50,
Zparameters = GRF,
Qparameters = GRF,
Cparameters = GRF)
## ---- Part A DGP --------------------------------------------------------------
## D1 = 1{a1 Z + Xb + u > 0}
## D2 = 1{psi D1 + a2(u) V Z + Xb + w - psi/2 > 0}   a2 = direct effect of Z on D2
## Y  = d1 D1 + d2 D2 + gam V Z + Xb + v              gam = direct effect of Z on Y
## V  = 1 (global) or MULT * 1{Xvar1 > XCUT} (local in X)
dgp <- function(n, a1 = .5, psi = 2.5, a2_lo = 0, a2_hi = 0, d1 = 1, d2 = 1,
gam = 0, ruw = 0, xloc = FALSE, potential = FALSE) {
S   <- matrix(c(1, .3, ruw, .3, 1, .3, ruw, .3, 1), 3)
e   <- MASS::mvrnorm(n, rep(0, 3), S); u <- e[, 1]; v <- e[, 2]; w <- e[, 3]
X   <- matrix(rnorm(n * 3), n, 3); xb <- drop(X %*% rep(.2, 3))
Z   <- rbinom(n, 1, .5)
V   <- if (xloc) MULT * (X[, 1] > XCUT) else 1
a2  <- ifelse(u < 0, a2_lo, a2_hi) * V
D1z <- function(z) as.integer(a1 * z + xb + u > 0)
D2dz <- function(d, z) as.integer(psi * d + a2 * z + xb + w - psi / 2 > 0)
if (potential) {
C <- D1z(1) > D1z(0)
return(c(first_stage = mean(C),
ED2_1_C = mean(D2dz(1, 0)[C]), ED2_0_C = mean(D2dz(0, 0)[C])))
}
D1 <- D1z(Z); D2 <- D2dz(D1, Z)
Y  <- d1 * D1 + d2 * D2 + gam * V * Z + xb + v
data.table(Xvar1 = X[, 1], Xvar2 = X[, 2], Xvar3 = X[, 3], Z, D1, D2, Y)
}
base <- list(
S0_null       = list(),
S0_boundary   = list(a1 = 0),     # zero first stage: every moment is exactly zero (boundary of the null)
S1_persistent = list(a2_lo = .5,  a2_hi = .5),
S2_nopersist  = list(a2_lo = .5,  a2_hi = .5, psi = 0),
S3_offsetting = list(a2_lo = .6,  a2_hi = -.6),
S4_directY    = list(gam = .8),
S5_harmlessD2 = list(a2_lo = .5,  a2_hi = .5, d2 = 0),
S6_jointwins  = list(a2_lo = .35, a2_hi = .35, d2 = 4, psi = .3, ruw = -.5)
)
## add a local-in-X version of every violating scenario (not of the null scenarios)
viol <- names(base)[!grepl("^S0", names(base))]
scen <- c(base, setNames(lapply(base[viol], function(a) c(a, xloc = TRUE)),
paste0(viol, "_X")))
## ---- Part B DGP (multivalued) ------------------------------------------------
## D1 = cut(a1 Z + Xb + u) at (0.3, 1.5); D2 = cut(s D1 + k + a2 M Z + 0.3 w) at (0.5, 1.5)
## M = 1 (global), MULT * 1{Xvar1 > XCUT} (local in X) or MULT * 1{D1 == dloc} (local in D)
dgp_mv <- function(n, s = 1, k = 0, a2 = 0, a1 = .6, xloc = FALSE, dloc = NA) {
X  <- matrix(rnorm(n * 3), n, 3); xb <- drop(X %*% rep(.2, 3))
Z  <- rbinom(n, 1, .5)
D1 <- findInterval(a1 * Z + xb + rnorm(n), c(.3, 1.5))
M  <- if (xloc) MULT * (X[, 1] > XCUT) else if (!is.na(dloc)) MULT * (D1 == dloc) else 1
D2 <- findInterval(s * D1 + k + a2 * M * Z + .3 * rnorm(n), c(.5, 1.5))
Y  <- D1 + D2 + xb + rnorm(n)
data.table(Xvar1 = X[, 1], Xvar2 = X[, 2], Xvar3 = X[, 3], Z, D1, D2, Y)
}
scen_mv <- list(
MV0_tracks     = list(),
MV0_boundary   = list(a1 = 0),    # zero first stage: boundary of the null
MV1_levelshift = list(k = 1),
MV2_amplify    = list(s = 2),
MV3_violation  = list(a2 = .15),
MV3_violation_X  = list(a2 = .15, xloc = TRUE),
MV3_violation_D2 = list(a2 = .25, dloc = 2)   # direct effect only among units with D1 = 2
)
## ---- Part C DGP (use case 2) -------------------------------------------------------
## D1 = 1{a1 Z + Xb + u > 0}                                     enrollment
## D2 = 1{s psi D1 + a2 V Z + Xb + w - c + 1{s < 0} psi > 0}      completion; s = -1 for a
##      share qdef of units (completion defiers: D2 falls when D1 rises), +1 otherwise
## Y  = d2 D2 + dd V D1 (1 - D2) + g V Z AT (1 - D2) + Xb + v
##      dd: effect of enrolling without completing (violates A4, harmless in use case 1)
##      g : direct effect of Z on the outcomes of always-enrollers who do not complete
##      AT = 1{Xb + u > 0} (enrolls without the offer)
## Lower persistence than Part A (psi = 1, c = 1): about half of enrollees complete.
dgp_uc2 <- function(n, a1 = .8, psi = 1, c = 1, a2 = 0, dd = 0, g = 0, qdef = 0, d2 = 1,
xloc = FALSE) {
S   <- matrix(c(1, .3, 0, .3, 1, .3, 0, .3, 1), 3)
e   <- MASS::mvrnorm(n, rep(0, 3), S); u <- e[, 1]; v <- e[, 2]; w <- e[, 3]
X   <- matrix(rnorm(n * 3), n, 3); xb <- drop(X %*% rep(.2, 3))
Z   <- rbinom(n, 1, .5)
V   <- if (xloc) MULT * (X[, 1] > XCUT) else 1
sg  <- ifelse(runif(n) < qdef, -1, 1)
D1  <- as.integer(a1 * Z + xb + u > 0)
D2  <- as.integer(sg * psi * D1 + a2 * V * Z + xb + w - c + (sg < 0) * psi > 0)
AT  <- as.integer(xb + u > 0)
Y   <- d2 * D2 + dd * V * D1 * (1 - D2) + g * V * Z * AT * (1 - D2) + xb + v
data.table(Xvar1 = X[, 1], Xvar2 = X[, 2], Xvar3 = X[, 3], Z, D1, D2, Y)
}
## Calibrated with population moments at n = 3000 (binary Y at the median):
## U1 is detected by the inner conditions only, U2 by the outer conditions only.
base_uc2 <- list(
U0_null       = list(),
U0_boundary   = list(a1 = 0),     # zero first stage: boundary of the null
U1_dropout    = list(dd = 1.5),   # enrolling without completing affects Y   (A4)
U2_directD2   = list(a2 = .5),    # direct effect of the offer on completion (A1)
U3_defiers    = list(qdef = .7),  # completion defiers                       (A5), a hard case
U4_ATdropoutY = list(g = 1)       # offer affects outcomes of always-enrollers who drop out
)
scen_uc2 <- c(base_uc2,
list(U1_dropout_X  = c(base_uc2$U1_dropout,  xloc = TRUE),
U2_directD2_X = c(base_uc2$U2_directD2, xloc = TRUE)))
## ---- montest wrapper -----------------------------------------------------------
## `fun` is montest or seqtest; a single-condition seqtest object has the same $minp and
## $time as a montest object, so both are summarized identically
## number of test-side hypotheses the minimum p-value is taken over (the multiplicity m in Holm); a
## multi-condition seqtest object has one montest fit per condition, so the counts are summed
n_tests <- function(o) {
cnt <- function(x) if (is.data.frame(x$results)) sum(x$results$train == FALSE, na.rm = TRUE) else 0
if (!is.null(o$results)) cnt(o) else sum(vapply(o[vapply(o, is.list, NA)], cnt, numeric(1L)))
}
run_mt <- function(dt, fml, seed, loc, ..., fun = montest) {
o <- NULL
args <- c(list(fml = as.formula(fml), data = dt, seed = seed, ...),
setNames(list(loc), LOCAL_ARG), MT_ARGS)
if (!isTRUE(loc)) args$pool <- "none"   # global tests: never pool across margins
err <- tryCatch({
invisible(capture.output(o <- suppressWarnings(suppressMessages(do.call(fun, args)))))
NULL
}, error = function(e) conditionMessage(e))
if (!is.null(err)) { if (PILOT) message("montest error (", fml, "): ", err); return(c(p = NA, t = NA, m = NA)) }
c(p = unname(o$minp[PCOL]), t = unname(o$time["Total", "elapsed"]), m = n_tests(o))
}
run_st <- function(dt, fml, seed, loc, ...) run_mt(dt, fml, seed, loc, ..., fun = seqtest)
X <- "Xvar1 + Xvar2 + Xvar3"
## ---- One replication -----------------------------------------------------------
one_rep <- function(s, r) {
seed <- 1e4 * match(s, names(scen)) + r
set.seed(seed)                      # montest resets the RNG internally, so seed per rep
dt <- do.call(dgp, c(list(n = N), scen[[s]]))
dt[, Ybin := cut(Y, quantile(Y, 0:NYBIN / NYBIN), include.lowest = TRUE, labels = FALSE) - 1L]
## seqtest builds D1 - D2 + 1 for FSD itself (the +1 shift keeps the support at {0,1,2}, so
## a downgrade to a binary treatment sees {0,1}, not {-1,0}); KRDY forms the joint (D2, Ybin) outcome
t0 <- proc.time()[3]
out <- rbindlist(lapply(c(FALSE, TRUE), function(L) {
rows <- list(
FSD    = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "FSD"),
KR_Y   = run_mt(dt, paste("Ybin ~", X, "| D1 ~ Z"),      seed, L, condition = "KR", Ysubsets = NYBIN),
KR_D2  = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "KRD", Ysubsets = 2L),
KR_D2Y = run_st(dt, paste("Ybin ~", X, "| D1 + D2 ~ Z"), seed, L, condition = "KRDY", Ysubsets = NYBIN))
## MW tests are run with local search only: without a search the MW statistic reduces to
## the first stage, so the global versions cannot reject
if (L) rows <- c(rows, list(
MW_Y   = run_mt(dt, paste("Y ~", X, "| D1 ~ Z"),         seed, L, condition = "MW"),
MW_D2  = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWD"),
MW_D2Y = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWDY")))
p <- do.call(rbind, rows)
data.table(test = rownames(p), search = if (L) "local" else "global", p = p[, "p"], t = p[, "t"], m = p[, "m"])
}))
out[, `:=`(scenario = s, rep = r, secs = proc.time()[3] - t0)]
}
one_rep_mv <- function(s, r) {
seed <- 1e4 * (100 + match(s, names(scen_mv))) + r
set.seed(seed)
dt <- do.call(dgp_mv, c(list(n = N), scen_mv[[s]]))
dt[, Ybin := cut(Y, quantile(Y, 0:NYBIN / NYBIN), include.lowest = TRUE, labels = FALSE) - 1L]
dt[, `:=`(Dd = D1 - D2 + 1L, T0 = (D1 > 0) - (D2 > 0) + 1L, T1 = (D1 > 1) - (D2 > 1) + 1L)]  # +1: see Part A
t0 <- proc.time()[3]
out <- rbindlist(lapply(c(FALSE, TRUE), function(L) {
thr <- rbind(run_mt(dt, paste("Y ~", X, "| T0 ~ Z"), seed, L, condition = "simple", linearD = TRUE),
run_mt(dt, paste("Y ~", X, "| T1 ~ Z"), seed, L, condition = "simple", linearD = TRUE))
p <- rbind(
FSD_mean = run_mt(dt, paste("Y ~", X, "| Dd ~ Z"), seed, L, condition = "simple", linearD = TRUE),
FSD_thr  = c(p = min(1, 2 * min(thr[, "p"])), t = sum(thr[, "t"]), m = sum(thr[, "m"])),   # Bonferroni; time and tests of both calls
KR_Y     = run_mt(dt, paste("Ybin ~", X, "| D1 ~ Z"), seed, L, condition = "KR",
Ysubsets = NYBIN, Dsubsets = 3L),
KR_D2    = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"), seed, L, condition = "KRD",
Ysubsets = 3L, Dsubsets = 3L),
KR_D2Y   = run_st(dt, paste("Ybin ~", X, "| D1 + D2 ~ Z"), seed, L, condition = "KRDY",
Ysubsets = NYBIN, Dsubsets = 3L))
## MW tests with local search only (see Part A); multivalued D1 uses the interior-value version
if (L) p <- rbind(p,
MW_Y   = run_mt(dt, paste("Y ~", X, "| D1 ~ Z"),         seed, L, condition = "MW"),
MW_D2  = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWD"),
MW_D2Y = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWDY"))
data.table(test = rownames(p), search = if (L) "local" else "global", p = p[, "p"], t = p[, "t"], m = p[, "m"])
}))
out[, `:=`(scenario = s, rep = r, secs = proc.time()[3] - t0)]
}
one_rep_uc2 <- function(s, r) {
seed <- 1e4 * (200 + match(s, names(scen_uc2))) + r
set.seed(seed)
dt <- do.call(dgp_uc2, c(list(n = N), scen_uc2[[s]]))
dt[, Ybin := cut(Y, quantile(Y, 0:NYBIN / NYBIN), include.lowest = TRUE, labels = FALSE) - 1L]
t0 <- proc.time()[3]
out <- rbindlist(lapply(c(FALSE, TRUE), function(L) {
rows <- list(
KRDY2    = run_st(dt, paste("Ybin ~", X, "| D1 + D2 ~ Z"), seed, L, condition = "KRDY2", Ysubsets = NYBIN),
KRDY     = run_st(dt, paste("Ybin ~", X, "| D1 + D2 ~ Z"), seed, L, condition = "KRDY",  Ysubsets = NYBIN),
KR_inner = run_mt(dt, paste("Ybin ~", X, "| D2 ~ Z"),      seed, L, condition = "KR",    Ysubsets = NYBIN))
## MW tests with local search only (see Part A)
if (L) {
rows <- c(rows, list(
MW_D2Y   = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWDY"),
MW_inner = run_mt(dt, paste("Y ~", X, "| D2 ~ Z"),         seed, L, condition = "MW"),
## joint MW test of both sets of conditions in one call (seqtest "MWDY2")
MW_joint = run_st(dt, paste("Y ~", X, "| D1 + D2 ~ Z"),    seed, L, condition = "MWDY2")))
}
p <- do.call(rbind, rows)
data.table(test = rownames(p), search = if (L) "local" else "global", p = p[, "p"], t = p[, "t"], m = p[, "m"])
}))
out[, `:=`(scenario = s, rep = r, secs = proc.time()[3] - t0)]
}
## ---- Run ------------------------------------------------------------------------
grid <- rbind(CJ(fam = "bin", s = names(scen),     r = seq_len(REPS)),
CJ(fam = "mv",  s = names(scen_mv),  r = seq_len(REPS)),
CJ(fam = "uc2", s = names(scen_uc2), r = seq_len(REPS)))
run_i <- function(i)
switch(grid$fam[i],
bin = one_rep(grid$s[i], grid$r[i]),
mv  = one_rep_mv(grid$s[i], grid$r[i]),
uc2 = one_rep_uc2(grid$s[i], grid$r[i]))
## Optional progress bar (PROGRESS): jobs are dispatched in chunks of 3 x CORES so the bar updates between chunks
## (a forked mclapply cannot update the parent's bar while it runs)
idx    <- seq_len(nrow(grid))
chunks <- split(idx, if (!PROGRESS) 1 else ceiling(idx / (if (CORES == 1) 1 else 3 * CORES)))
if (PROGRESS) pb <- txtProgressBar(min = 0, max = length(idx), style = 3)
if (CORES > 1 && .Platform$OS.type == "windows") {
## Windows has no forking: start PSOCK workers, load packages, copy the workspace
cl <- makeCluster(CORES)
clusterEvalQ(cl, { library(data.table); library(montest); NULL })
clusterExport(cl, ls(globalenv()))
}
res <- vector("list", length(chunks))
for (k in seq_along(chunks)) {
ch <- chunks[[k]]
res[[k]] <- rbindlist(
if (CORES == 1) lapply(ch, run_i)
else if (.Platform$OS.type == "windows") parLapplyLB(cl, ch, run_i)
else mclapply(ch, run_i, mc.cores = CORES, mc.preschedule = FALSE))
if (PROGRESS) setTxtProgressBar(pb, max(ch))
}
if (PROGRESS) close(pb)
if (exists("cl")) stopCluster(cl)
res <- rbindlist(res)
## ---- Summaries --------------------------------------------------------------------
rr <- res[, .(rej = mean(p < ALPHA, na.rm = TRUE), t = mean(t, na.rm = TRUE), m = mean(m, na.rm = TRUE)),
by = .(scenario, test, search)]
## rejection rates by scenario, plus a final row with montest time (s) averaged across scenarios
tab <- function(sub) {
rej <- dcast(sub, scenario ~ test + search, value.var = "rej")
tim <- dcast(sub[, .(scenario = "mean_secs", v = mean(t)), by = .(test, search)],
scenario ~ test + search, value.var = "v")
nt  <- dcast(sub[, .(scenario = "mean_tests", v = mean(m)), by = .(test, search)],
scenario ~ test + search, value.var = "v")
rbind(rej, tim, nt)
}
cat("\nRejection rates (", PCOL, ", alpha =", ALPHA, ", reps =", REPS, ")\n")
cat("Part A (binary):\n");      print(tab(rr[grepl("^S", scenario)]))
cat("Part B (multivalued):\n"); print(tab(rr[grepl("^MV", scenario)]))
cat("Part C (use case 2):\n");  print(tab(rr[grepl("^U", scenario)]))
cat("\nFailed calls (NA p-values):", res[, sum(is.na(p))], "\n")
## ---- LaTeX table bodies (Panels A, B and C) --------------------------------------------
## Writes only the rows (the "meat"): one row per scenario with 8 numeric columns (9 in
## Panel B), then a \midrule and rows with average seconds per test and average number of tests. Local-in-X scenarios are
## labelled as indented continuations of the row above. The last row has no closing \\\\: the
## table adds it after the \\input (a \\\\ at the end of an input file breaks a following \\addlinespace).
fmt <- function(x, d) if (length(x) == 0L || is.na(x)) "" else formatC(x, format = "f", digits = d)
## Row labels are written as macros (\\rowSzeroNull etc.), defined in LABELFILE inside TEXDIR. The label
## file is never overwritten: it is created on the first run, and later runs only append macros that
## are missing, so hand edits of the label text survive a new simulation run.
LABELFILE <- "sim_rowlabels.tex"
macro_name <- function(sc) {                    # S1_persistent_X -> \\rowSonePersistentX
w <- c("zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine")
parts <- strsplit(sc, "_")[[1]]
parts <- vapply(parts, function(p) paste0(toupper(substring(p, 1, 1)), substring(p, 2)), "")
ch <- strsplit(paste(parts, collapse = ""), "")[[1]]
dig <- grepl("[0-9]", ch)
ch[dig] <- vapply(ch[dig], function(d) paste0(toupper(substring(w[as.integer(d) + 1], 1, 1)),
substring(w[as.integer(d) + 1], 2)), "")
nm <- paste(ch, collapse = "")
paste0("\\row", nm)
}
update_labels <- function(defs) {               # defs: named character vector, macro name -> label text
f <- file.path(TEXDIR, LABELFILE)
old <- if (file.exists(f)) readLines(f) else
c("% Row labels for the simulation tables. Created by sim_KR.R; edit freely, new runs never",
"% overwrite this file (they only append macros that are missing).")
new <- defs[!vapply(names(defs), function(m) any(startsWith(old, paste0("\\newcommand{", m, "}"))), NA)]
if (length(new))
writeLines(c(old, paste0("\\newcommand{", names(new), "}{", new, "}")), f)
}
write_meat <- function(sub, rows, cols, file) {
cell <- function(sc, cc, what, d) {
if (is.null(cc)) return("")
v <- sub[scenario == sc & test == cc[1] & search == cc[2], get(what)]
fmt(v, d)
}
keep <- names(rows)[names(rows) %in% sub$scenario]
mac  <- setNames(vapply(keep, macro_name, ""), keep)
update_labels(c(setNames(rows[keep], mac), c("\\rowSeconds" = "Seconds per test", "\\rowNTests" = "Number of tests")))
body <- vapply(keep, function(sc)
paste0(mac[[sc]], " & ",
paste(vapply(cols, function(cc) cell(sc, cc, "rej", 2), ""), collapse = " & "), " \\\\"), "")
secs <- vapply(cols, function(cc) {
if (is.null(cc)) return("")
fmt(sub[test == cc[1] & search == cc[2], mean(t, na.rm = TRUE)], 1)
}, "")
ntest <- vapply(cols, function(cc) {
if (is.null(cc)) return("")
fmt(sub[test == cc[1] & search == cc[2], mean(m, na.rm = TRUE)], 1)
}, "")
writeLines(c(body, "\\midrule", paste0("\\rowSeconds & ", paste(secs, collapse = " & "), " \\\\"),
paste0("\\rowNTests & ", paste(ntest, collapse = " & "))),
file.path(TEXDIR, file))
}
locX <- "$\\quad$\\ldots local in $X$"
rows_A <- c(
S0_null         = "S0: Null",
S0_boundary     = "S0: Boundary, zero first stage",
S1_persistent   = "S1: Persistent",          S1_persistent_X = locX,
S2_nopersist    = "S2: No persistence",      S2_nopersist_X  = locX,
S3_offsetting   = "S3: Offsetting",          S3_offsetting_X = locX,
S4_directY      = "S4: Direct on $Y$",       S4_directY_X    = locX,
S5_harmlessD2   = "S5: Harmless $D_2$",      S5_harmlessD2_X = locX,
S6_jointwins    = "S6: Large $\\delta_2$",   S6_jointwins_X  = locX)
## 8 columns: FSD, then KR and MW with W = Y, D2, (D2,Y), all with local search (the package
## default; global MW cannot reject), and a global KR-(D2,Y) reference for the cost/gain of search
cols_A <- list(c("FSD", "local"),
c("KR_Y", "local"),   c("KR_D2", "local"),  c("KR_D2Y", "local"),
c("MW_Y", "local"),   c("MW_D2", "local"),  c("MW_D2Y", "local"),
c("KR_D2Y", "global"))
rows_B <- c(
MV0_tracks       = "MV0: $D_2$ tracks $D_1$ (valid)",
MV0_boundary     = "MV0: Boundary, zero first stage",
MV1_levelshift   = "MV1: Level shift (valid)",
MV2_amplify      = "MV2: Amplification (valid)",
MV3_violation    = "MV3: Direct on $D_2$",
MV3_violation_X  = locX,
MV3_violation_D2 = "$\\quad$\\ldots only at $D_1=2$")
## 9 columns (Panel B is its own table): both FSD versions, then KR and MW with W = Y, D2, (D2,Y),
## all local, and the global KR-(D2,Y) reference, mirroring Panel A
cols_B <- list(c("FSD_mean", "local"), c("FSD_thr", "local"),
c("KR_Y", "local"),     c("KR_D2", "local"),  c("KR_D2Y", "local"),
c("MW_Y", "local"),     c("MW_D2", "local"),  c("MW_D2Y", "local"),
c("KR_D2Y", "global"))
rows_C <- c(
U0_null       = "U0: Null",
U0_boundary   = "U0: Boundary, zero first stage",
U1_dropout    = "U1: Dropout effect",          U1_dropout_X  = locX,
U2_directD2   = "U2: Direct on $D_2$",         U2_directD2_X = locX,
U3_defiers    = "U3: Completion defiers",
U4_ATdropoutY = "U4: Direct on $Y$, enrolled dropouts")
## 8 columns: KR first-treatment (outer, KRDY), second-treatment (inner, classic KR for D2 -> Y)
## and joint (KRDY2) conditions with local search, then the global joint and global second-treatment
## KR tests (the cost/gain of search); then the local MW versions (MWDY, MW, MWDY2)
cols_C <- list(c("KRDY", "local"),     c("KR_inner", "local"),  c("KRDY2", "local"),
c("KRDY2", "global"),   c("KR_inner", "global"),
c("MW_D2Y", "local"),   c("MW_inner", "local"),  c("MW_joint", "local"))
write_meat(rr[grepl("^S", scenario)],  rows_A, cols_A, "sim_panelA.tex")
write_meat(rr[grepl("^MV", scenario)], rows_B, cols_B, "sim_panelB.tex")
write_meat(rr[grepl("^U", scenario)],  rows_C, cols_C, "sim_panelC.tex")
cat("LaTeX table bodies written to",
file.path(TEXDIR, c("sim_panelA.tex", "sim_panelB.tex", "sim_panelC.tex")), "\n")
cat("\nOracle complier persistence and first stage, Part A (n = 2e5):\n")
set.seed(1)
print(rbindlist(lapply(scen, function(a)
as.list(do.call(dgp, c(list(n = 2e5, potential = TRUE), a)))), idcol = "scenario"), digits = 3)
if (PILOT) {
secs <- res[, .(s = secs[1]), by = .(scenario, rep)][, mean(s)]
ns   <- length(scen) + length(scen_mv) + length(scen_uc2); cores <- max(1, detectCores() - 2)
cat(sprintf("\nPilot: %.1f s per replication (11 calls in Part A, 12 in Part B, 9 in Part C). Full run (%d scenarios x 100 reps, %d cores): ~%.0f min\n",
secs, ns, cores, secs * ns * 100 / cores / 60))
}
