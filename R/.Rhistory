montests=list()
output=c()
library(digest)
library(haven)
library(data.table)
library(grf)
seed_from_name <- function(name, master_seed = 12345) {
h <- digest(paste0(master_seed, "_", name), algo = "xxhash32")
as.integer(strtoi(substr(h, 1, 7), base = 16))
}
parse_fixest_fe <- function(fe_string) {
split_top_level <- function(x) {
chars <- strsplit(x, "", fixed = TRUE)[[1]]
depth <- 0L
cur <- character()
out <- character()
for (ch in chars) {
if (ch == "[") {
depth <- depth + 1L
} else if (ch == "]") {
depth <- depth - 1L
}
if (ch == "+" && depth == 0L) {
out <- c(out, paste(cur, collapse = ""))
cur <- character()
} else {
cur <- c(cur, ch)
}
}
out <- c(out, paste(cur, collapse = ""))
trimws(out[nzchar(trimws(out))])
}
terms <- split_top_level(fe_string)
out <- character()
for (term in terms) {
term <- trimws(term)
if (grepl("\\[", term)) {
m <- regexec("^([^[]+)\\[([^]]+)\\]$", term)
hit <- regmatches(term, m)[[1]]
if (length(hit) != 3) {
stop(sprintf("Could not parse FE term: '%s'", term))
}
var1 <- trimws(hit[2])
inside <- trimws(hit[3])
vars2 <- split_top_level(inside)
out <- c(out, paste0("factor(", var1, "):", vars2))
} else {
out <- c(out, paste0("factor(", term, ")"))
}
}
paste(out, collapse = " + ")
}
add_mm_from_spec <- function(data, spec, prefix = "fe", drop_intercept = TRUE) {
if (!is.data.table(data)) data <- as.data.table(data)
mm <- model.matrix(as.formula(spec), data = data, na.action = na.pass)
if (drop_intercept && "(Intercept)" %in% colnames(mm)) {
mm <- mm[, colnames(mm) != "(Intercept)", drop = FALSE]
}
nm <- colnames(mm)
nm <- gsub("factor\\(([^)]+)\\)", "\\1", nm)
nm <- gsub(":", "_X_", nm)
nm <- gsub("[() ,]+", "_", nm)
nm <- gsub("_+", "_", nm)
nm <- gsub("^_|_$", "", nm)
nm <- paste0(prefix, "_", nm)
nm <- make.unique(make.names(nm))
colnames(mm) <- nm
data[, (nm) := as.data.table(mm)]
invisible(list(data = data, new_cols = nm, matrix = mm))
}
